  "config.universalkeyboard.keyboard.keyboardRange": "Keyboard Range",
  "config.universalkeyboard.keyboard.keyboardRange.tooltip": "Max wireless range in blocks between the keyboard and its linked target. Events are dropped if the player exceeds this distance. Set above 2 million to reach sub-levels. Default: 32.",
  "config.universalkeyboard.keyboard.copycatLocateDuration": "Copycat Locate Duration",
  "config.universalkeyboard.keyboard.copycatLocateDuration.tooltip": "Duration in seconds for the Wireless Copycat test-face feature. Applies to both the per-face Test button on the Copycat and the Locate button on the keyboard. Default: 5.",
  "config.universalkeyboard.keyboard.favoriteLiveControlAutoStart": "Favorite Auto-Start",
  "config.universalkeyboard.keyboard.favoriteLiveControlAutoStart.tooltip": "When true, right-clicking the keyboard immediately starts Live Controls without opening the main menu. The Live Controller screen must also be marked as Favorite. Shift-click the keyboard to open the main menu instead. Default: false.",

  "config.universalkeyboard.gamepad.enableGamepad": "Enable Gamepad",
  "config.universalkeyboard.gamepad.enableGamepad.tooltip": "Allow a connected gamepad to drive Live Controller bindings. When on, gamepad buttons, triggers, and sticks can be bound just like keyboard keys. Uses GLFW standard gamepad mapping, so any recognized controller works. Default: true.",
  "config.universalkeyboard.gamepad.enableAdvancedInput": "Enable Advanced Input",
  "config.universalkeyboard.gamepad.enableAdvancedInput.tooltip": "Read controllers as raw joysticks instead of mapped gamepads. Turn on for HOTAS, flight sticks, racing wheels, and other devices GLFW does not recognise as standard gamepads. Exposes all axes, buttons, and hat switches by number. Leave off if you only use standard gamepads. Default: false.",
  "config.universalkeyboard.mouse.enableMouseInput": "Enable Mouse Input",
  "config.universalkeyboard.mouse.enableMouseInput.tooltip": "Allow the mouse to be bound in live controls Default: false.",
  "config.universalkeyboard.mouse.mouseAbsoluteMode": "Absolute Mouse Mode",
  "config.universalkeyboard.mouse.mouseAbsoluteMode.tooltip": "false (Velocity mode, default): mimics a real joystick, measures input speed as the power, and reverts back to 0. true (Absolute mode): mimics the Aeroworks' joystick, which keeps the cursor locked where you put it.",
  "config.universalkeyboard.mouse.mouseAxisSensitivity": "Mouse Axis Sensitivity",
  "config.universalkeyboard.mouse.mouseAxisSensitivity.tooltip": "Multiplier for how strongly mouse movement deflects its analog axes. Default: 1.0.",
  "config.universalkeyboard.animations.enableKeyboardAnimations": "Enable Keyboard Animations",
  "config.universalkeyboard.animations.enableKeyboardAnimations.tooltip": "Turns off all keyboard animations if false. Default: true.",
  "config.universalkeyboard.animations.doubleExplosion": "Double Explosion",
  "config.universalkeyboard.animations.doubleExplosion.tooltip": "Double explosion!!",
  "config.universalkeyboard.animations.mainWaveSpeed": "Main Wave Speed",
  "config.universalkeyboard.animations.mainWaveSpeed.tooltip": "Keyboard's main wave animation speed. Default: 0.15.",
  "config.universalkeyboard.animations.clusterWaveSpeed": "Cluster Wave Speed",
  "config.universalkeyboard.animations.clusterWaveSpeed.tooltip": "Keyboard's cluster animation speed. Default: 0.05.",
  "config.universalkeyboard.gamepad.stickThreshold": "Stick Threshold",
  "config.universalkeyboard.gamepad.stickThreshold.tooltip": "How far an analog stick must be pushed before it counts as a directional press. Range: 0.1–1.0. Default: 0.2.",
  "config.universalkeyboard.gamepad.triggerThreshold": "Trigger Threshold",
  "config.universalkeyboard.gamepad.triggerThreshold.tooltip": "How far a trigger (LT/RT) must be pulled before it counts as a press. Range: 0.1–1.0. Default: 0.5.",
  "config.universalkeyboard.gamepad.joystickScaling": "Joystick Scaling",
  "config.universalkeyboard.gamepad.joystickScaling.tooltip": "Scale a binding's output by how far the stick or trigger is pushed. When on, an analog input bound to 50% power outputs proportionally — pushing the stick halfway sends 25%, fully sends 50%. Applies to RS, Thruster Power, Vector, and Variable bindings in Hld/Tog modes. Buttons and Inc/Overdrive bindings are never scaled. Default: true.",
  "config.universalkeyboard.gamepad.stickCalibration": "Stick Calibration",
  "config.universalkeyboard.gamepad.stickCalibration.tooltip": "Per-axis maximum stick deflection recorded by calibration. Order: [Left X, Left Y, Right X, Right Y]. Values below 1.0 mean the stick physically falls short of the theoretical edge; analog output is rescaled so the stick's real maximum maps to 100%. Set with the Calibrate button in the Live Controller. Default: 1.0 each.",
  "config.universalkeyboard.controlwheel.controlWheelLeftRows": "Control Wheel — Left Turn Rows",
  "config.universalkeyboard.controlwheel.controlWheelLeftRows.tooltip": "Comma-separated Live Controller row numbers (1–40) whose active state animates the Control Wheel turning left. Works with any input device — keyboard, gamepad sticks, triggers, etc. Example: \"1,3\". Leave blank to disable.",
  "config.universalkeyboard.controlwheel.controlWheelRightRows": "Control Wheel — Right Turn Rows",
  "config.universalkeyboard.controlwheel.controlWheelRightRows.tooltip": "Comma-separated Live Controller row numbers (1–40) whose active state animates the Control Wheel turning right. Works with any input device. Example: \"2,4\". Leave blank to disable.",

  "key.categories.universalkeyboard": "Universal Keyboard",
